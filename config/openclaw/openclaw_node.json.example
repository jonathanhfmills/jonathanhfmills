{
  "$schema": "openclaw_schema.json",
  "gateway": {
    "bind": "loopback",
    "mode": "local",
    "auth": {
      "mode": "token",
      "allowTailscale": true
    },
    "tailscale": {
      "mode": "serve",
      "serviceName": "svc:openclaw"
    }
  },
  "models": {
    "mode": "replace",
    "providers": {
      "lmstudio": {
        "baseUrl": "http://127.0.0.1:1234",
        "apiKey": "SET_ME"
      },
      "qwen": {
        "baseUrl": "http://127.0.0.1:4170",
        "apiKey": "SET_ME"
      }
    }
  },
  "agents": {
    "defaults": {
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "5m"
      },
      "memorySearch": {
        "provider": "lmstudio",
        "model": "lmstudio/gemma-4-e4b-it-qat",
        "outputDimensionality": 2048,
        "fallback": "none",
        "multimodal": {
          "enabled": true,
          "modalities": [
            "image",
            "audio"
          ]
        },
        "extraPaths": [
          "./memory/media"
        ],
        "query": {
          "hybrid": {
            "mmr": {
              "enabled": true
            },
            "temporalDecay": {
              "enabled": true
            }
          }
        }
      },
      "compaction": {
        "model": "lmstudio/gemma-4-12b-it-qat",
        "memoryFlush": {
          "model": "lmstudio/gemma-4-12b-it-qat"
        }
      },
      "experimental": {
        "localModelLean": true
      }
    },
    "list": [
      {
        "id": "main",
        "workspace": "~/.openclaw/workspace",
        "model": "lmstudio/qwen3.5-9b-mtp",
        "name": "Orchestrator: Wanda",
        "tools": {
          "profile": "full"
        }
      },
      {
        "id": "operator",
        "workspace": "~/.openclaw/workspace",
        "model": "lmstudio/qwen3.5-9b-mtp",
        "name": "Operator: Cosmo",
        "tools": {
          "profile": "full"
        }
      }
    ]
  },
  "acp": {
    "enabled": true,
    "dispatch": {
      "enabled": true
    },
    "backend": "acpx",
    "defaultAgent": "claude",
    "allowedAgents": [
      "claude",
      "codex",
      "gemini",
      "openclaw",
      "qwen"
    ],
    "maxConcurrentSessions": 5,
    "stream": {
      "coalesceIdleMs": 350,
      "maxChunkChars": 1800
    },
    "runtime": {
      "ttlMinutes": 120
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.7.1",
    "lastTouchedAt": "2026-07-25T17:52:08.839Z"
  },
  "commitments": {
    "enabled": true
  },
  "plugins": {
    "entries": {
      "google": {
        "enabled": true,
        "config": {
          "webSearch": {
            "model": "lmstudio/gemma-4-12b-it-qat",
            "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
            "apiKey": "SET_ME"
          }
        }
      },
      "memory-core": {
        "enabled": true,
        "config": {
          "dreaming": {
            "enabled": true
          }
        }
      },
      "memory-wiki": {
        "enabled": true,
        "config": {
          "search": {
            "backend": "shared",
            "corpus": "all"
          },
          "context": {
            "includeCompiledDigestPrompt": true
          }
        }
      },
      "active-memory": {
        "enabled": true,
        "config": {
          "model": "lmstudio/gemma-4-12b-it-qat",
          "modelFallback": "lmstudio/gemma-4-e4b-it-qat",
          "agents": [
            "main",
            "env",
            "mue",
            "ntr"
          ],
          "queryMode": "full",
          "logging": true
        }
      },
      "workboard": {
        "enabled": true
      },
      "qwen": {
        "enabled": true
      },
      "open-prose": {
        "enabled": true
      },
      "acpx": {
        "enabled": true,
        "config": {
          "pluginToolsMcpBridge": true,
          "timeoutSeconds": 180,
          "permissionMode": "approve-reads",
          "probeAgent": "claude",
          "nonInteractivePermissions": "deny",
          "openClawToolsMcpBridge": true
        }
      },
      "discord": {
        "enabled": true
      },
